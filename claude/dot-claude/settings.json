{
  "effortLevel": "low",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gitkraken-hooks@gitkraken": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '~/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "wt list statusline --format=claude-code"
  },
  "model": "sonnet",
  "tui": "fullscreen"
}
