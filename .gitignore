.zshrc.local
navi/dot-config/navi/navi.log
herdr/dot-config/herdr/*
!herdr/dot-config/herdr/.gitkeep
!herdr/dot-config/herdr/config.toml
!herdr/dot-config/herdr/plugins.json
!herdr/dot-config/herdr/.plugins.lock
!herdr/dot-config/herdr/plugins/
herdr/dot-config/herdr/plugins/*
!herdr/dot-config/herdr/plugins/local/
!herdr/dot-config/herdr/plugins/local/**

# local HTTP client secrets
http/**/.env
http/**/http-client.private.env.json

# managed by `aws agent-toolkit` (add-skill / update-skill / remove-skill)
claude/dot-claude/skills/aws-*/
claude/dot-claude/skills/amazon-bedrock/
claude/dot-claude/skills/launch-with-aws/
claude/dot-claude/skills/signing-in-to-aws/

# Claude Desktop skill sync and Claude Code trash
claude/dot-claude/skills/synced/
claude/dot-claude/skills/.trash/

# generated / machine-local files
__pycache__/
*.pyc
worktrunk/dot-config/worktrunk/config.toml.bak
worktrunk/dot-config/worktrunk/config.toml.lock
ssh/dot-ssh/known_hosts
ssh/dot-ssh/known_hosts.old
